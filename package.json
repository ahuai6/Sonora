{
  "name": "sonora-desktop",
  "productName": "Sonora",
  "version": "1.3.3",
  "description": "声屿 · 多平台音乐试听与本地音乐管理",
  "author": "Sonora contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:live": "node scripts/check-live.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:collections": "node --test tests/collections.test.mjs && node tests/collections-e2e.mjs",
    "test:jerry": "node --test tests/jerry.test.mjs && node tests/jerry-e2e.mjs",
    "test:account-playlists": "node tests/account-playlists-e2e.mjs",
    "package": "npm run build && electron-builder --win portable --x64 && node scripts/check-bundled-jerry.mjs",
    "package:dir": "npm run build && electron-builder --win --dir --x64 && node scripts/check-bundled-jerry.mjs"
  },
  "dependencies": {
    "@neteasecloudmusicapienhanced/api": "4.41.1",
    "@sansenjian/qq-music-api": "2.6.0",
    "@xmldom/xmldom": "0.9.12",
    "kugoumusicapi": "file:vendor/kugou",
    "music-metadata": "12.3.2",
    "node-taglib-sharp": "6.0.3",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.1",
    "lucide-react": "1.64.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "local.sonora.desktop",
    "productName": "Sonora",
    "artifactName": "Sonora-${version}-Windows-x64.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main/**/*",
      "profiles/**/*",
      "build/icon.ico",
      "package.json",
      "THIRD-PARTY-NOTICES.md"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Sonora-${version}-Windows-x64.exe"
    }
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11 <13"
  },
  "overrides": {
    "basic-ftp": "6.2.3",
    "node-taglib-sharp": {
      "uuid": "14.0.3"
    }
  },
  "packageManager": "npm@11.21.1"
}
